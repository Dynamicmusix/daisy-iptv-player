{
  "version": 2,
  "framework": null,
  "functions": {
    "api/portal.js": {
      "maxDuration": 30
    },
    "api/stream.js": {
      "maxDuration": 60
    },
    "api/stop-stream.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/portal", "destination": "/api/portal.js" },
    { "source": "/api/stream", "destination": "/api/stream.js" },
    { "source": "/api/stop-stream", "destination": "/api/stop-stream.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ]
}
